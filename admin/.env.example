# ==============================================================================
# REHVO — Web Admin Control Panel (Next.js) Environment Variables
# Copy this file to `.env.local` inside the `admin/` directory.
# Must connect to the SAME South Asia (Mumbai) Supabase Project as the Mobile App.
# ==============================================================================

# Public Supabase Configuration (Client & Server)
# URL of your Mumbai Supabase project (e.g., https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable / Anon Key (safe for browser client)
# You can use either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# PRIVILEGED SERVER-ONLY KEY
# NEVER prefix with NEXT_PUBLIC_ and NEVER import into client components.
# Used exclusively by admin/src/lib/supabase/admin.ts on the server.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
