# ==============================================================================
# REHVO — Mobile App (Expo / React Native) Environment Variables
# Copy this file to `.env` in the root directory and fill in your actual values.
# Region: South Asia (Mumbai) Supabase Project
# ==============================================================================

# Supabase Project Configuration (REQUIRED)
# URL of your Mumbai Supabase project (e.g., https://your-project-ref.supabase.co)
EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable / Anon Key (safe to expose in mobile client code)
# You can use either EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY or EXPO_PUBLIC_SUPABASE_ANON_KEY
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
# EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# App URL scheme for deep linking (matches expo.scheme in app.json)
APP_URL="rehvo://"

# ------------------------------------------------------------------------------
# SECURITY NOTICE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY in this file or any mobile code.
# The service role key is strictly server-only for administrative use.
# ------------------------------------------------------------------------------
